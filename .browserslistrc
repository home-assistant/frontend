[modern]
# Modern builds target recent browsers supporting the latest features to minimize transpilation, polyfills, etc.
# It is served to browsers meeting the following requirements:
# - released in the last 2 years + current alpha/beta versions
# - exclude dead browsers (no security maintenance for 2+ years)
# - exclude QQ, and UC browsers due to lack of sufficient feature support data
unreleased versions
last 2 years
not dead
not QQAndroid > 0
not UCAndroid > 0

[legacy]
# Legacy builds are served when modern requirements are not met.
# Floors are pinned explicitly (not usage-based) so the support policy is
# deliberate and does not drift with global usage statistics, which do not
# represent old tablets and wall displays used as Home Assistant dashboards:
# - iOS/Safari >= 15.4: where native <dialog> (ha-drawer, popovers,
#   wa-dialog) landed. Dropped: the iOS 12 devices, iPad Air 1 / mini 2 /
#   mini 3, iPhone 5s / 6 / 6 Plus and iPod touch 6. Nothing ends between
#   iOS 12 and 15.8, so no other device is affected. On the Mac, Safari 15.4
#   runs on macOS 10.15 Catalina and later. The Chrome floor, not Safari,
#   decides what the legacy build has to transpile.
# - Chrome >= 67: the first Chromium with BigInt, which Babel cannot
#   transpile. The boundary on Fire tablets is the Amazon WebView build, not
#   the Fire OS major: WebView 70+ (Fire OS 5.6.4+ on the 2017 models, Fire
#   OS 6.3.1.2+, Fire OS 7) keeps working, WebView 59 (Fire OS 5 on the 2015
#   and 2016 models, Fire OS 6.3.0.1) is dropped. Also covers the Chromecast
#   1st gen (frozen at Chrome 70, the next hard ceiling) and old kiosk
#   webviews above it.
# - Edge >= 79: all Chromium-based Edge. Costs nothing (above the Chrome
#   floor); mainly catches Edge 109 on Windows 7/8.1 and update-frozen
#   enterprise installs, whose engines can run the legacy build fine.
# - Firefox >= 98: where native <dialog> landed; otherwise a zero-cost floor,
#   not a chased population — pinning it adds no babel transforms, core-js
#   modules, or Lightning CSS prefixes to the output. Mozilla-supported Firefox (incl. current ESR) always matches
#   [modern]; Firefox on old OSes is not supported (use Chrome 109 instead).
#   If Firefox ever becomes the pin forcing extra output, raise it first.
# - Samsung >= 9: Samsung Internet on old Galaxy tablets (9.2 is Chromium 67)
Chrome >= 67
ChromeAndroid >= 67
Edge >= 79
Firefox >= 98
FirefoxAndroid >= 98
iOS >= 15.4
Safari >= 15.4
Samsung >= 9

[legacy-sw]
# Same as legacy, restricted to browsers that support service workers
# (currently resolves to the same set; guards the service worker build if the legacy floor ever drops below them)
Chrome >= 67 and supports serviceworkers
ChromeAndroid >= 67 and supports serviceworkers
Edge >= 79 and supports serviceworkers
Firefox >= 98 and supports serviceworkers
FirefoxAndroid >= 98 and supports serviceworkers
iOS >= 15.4 and supports serviceworkers
Safari >= 15.4 and supports serviceworkers
Samsung >= 9 and supports serviceworkers
