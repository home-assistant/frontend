<style>
  #ha-launch-screen {
    font-family: ui-sans-serif, system-ui, sans-serif;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    user-select: none;
    -webkit-user-select: none;
    background-color: var(--primary-background-color, #fafafa);
    z-index: 100;
    transition: opacity var(--ha-animation-duration-normal, 250ms) ease-out;
  }
  #ha-launch-screen.removing {
    opacity: 0;
  }
  @keyframes launch-lockup-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  #ha-launch-screen .ha-lockup {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    animation: launch-lockup-in var(--ha-animation-duration-normal, 250ms) ease-out both;
  }
  #ha-launch-screen-info-box > *,
  #ha-launch-screen .ohf-logo {
    animation: launch-lockup-in var(--ha-animation-duration-normal, 250ms) ease-out both;
  }
  #ha-launch-screen .ha-logo {
    width: 96px;
    height: 96px;
  }
  #ha-launch-screen .ha-launch-screen-spacer-top {
    flex: 1;
    margin-top: 142px;
    padding-top: 48px;
  }
  #ha-launch-screen .ha-launch-screen-spacer-bottom {
    flex: 1;
    padding-top: 16px;
  }
  #ha-launch-screen-info-box p {
    max-width: 400px;
    margin: 0 16px 16px;
    text-align: center;
  }
  /* Margins, not flex `gap` (Safari 14.1). */
  #ha-launch-screen .ha-launch-screen-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 16px;
  }
  #ha-launch-screen .ha-launch-screen-actions label {
    display: flex;
    align-items: center;
    margin-top: 8px;
    padding: 8px 16px;
    font-size: 14px;
    cursor: pointer;
  }
  #ha-launch-screen .ha-launch-screen-actions input {
    margin: 0 8px 0 0;
    accent-color: #009ac7;
  }
  #ha-launch-screen .ha-launch-screen-actions button {
    padding: 8px 16px;
    border: 1px solid currentColor;
    border-radius: 18px;
    background: none;
    color: #009ac7;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .ohf-logo {
    margin: 48px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    opacity: .66;
  }
  .ohf-logo span {
    font-size: 12px;
    line-height: 12px;
    text-transform: uppercase;
  }
  .ohf-logo picture {
    display: flex;
  }
  .ohf-logo img {
    width: 237px;
    aspect-ratio: 237 / 24;
    height: auto;
  }
  /* max() with var() fails after the cascade, so plain fallbacks above
     need @supports (Chrome below 79). `body`: Jinja2, see below. */
  @supports (margin: max(1px, 2px)) {
    body #ha-launch-screen .ha-launch-screen-spacer-top {
      margin-top: calc( 2 * max(var(--safe-area-inset-top, 0px), 48px) + 46px );
    }
    .ohf-logo {
      margin: max(var(--safe-area-inset-bottom, 0px), 48px) 0;
    }
  }
  @media (prefers-color-scheme: dark) {
    /* body selector to avoid minification causing bad jinja2 */
    body #ha-launch-screen {
      background-color: var(--primary-background-color, #111111);
    }
  }
  @media (max-height: 560px) {
    /* body selector to avoid minification causing bad jinja2 */
    body #ha-launch-screen .ha-launch-screen-spacer-top {
      margin-top: 24px;
      padding-top: 24px;
    }
    body #ha-launch-screen .ha-launch-screen-spacer-bottom {
      padding-top: 16px;
    }
    .ohf-logo {
      margin-block: 24px;
    }
  }
</style>
